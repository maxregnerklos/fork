// Maxregneros Modern Theme
class Theme {
	var background: Color = Color(240, 240, 245)
	var window: Color = Color(255, 255, 255)
	var accent: Color = Color(0, 120, 255)
	var border: Color = Color(200, 200, 210)
	var font: Font = Font("San Francisco", 18, dpi_scale())

	static fun current() -> Theme {
		return Theme()
	}
}

fun dpi_scale() -> Float {
	return GPU.getDPIScale()
}

var justBlur = false
var wallpaperSource Bitmap32 = null
